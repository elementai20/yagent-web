# Inlined into the bundle at build time (next build). Not a secret — just the
# backend's public URL. The app derives the WebSocket URL from it (https→wss).
#
# star-map-y has no deployed backend yet. Left EMPTY on purpose: the app then
# uses same-origin relative paths, which is correct for the monolith deploy
# (backend serves ../yagent-web/dist). Do NOT point it at the old yagent prod
# backend — a build would silently spend real budget on the wrong deployment.
NEXT_PUBLIC_API_BASE=

# 遊戲世界的公開位址。留空則沿用程式內的預設 http://localhost:8081；
# 真的要部署時填 WorkAdventure 那套的對外網域。
NEXT_PUBLIC_GAME_URL=
