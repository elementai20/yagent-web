# Backend origin. In dev .env.development points this at http://localhost:3001.
# For a split prod deploy set it to the backend's public URL at BUILD time
# (Next inlines NEXT_PUBLIC_* into the bundle). Leave empty to use same-origin
# relative paths (monolith: backend serves web/dist on the same host).
# NEXT_PUBLIC_API_BASE=https://yagent-backend.zeabur.app
